/* ==========================================================================
   Automatizador de Fichas v0.2.0 — Dark Theme (Tailwind Slate + Blue)
   ========================================================================== */

QWidget {
    background-color: #020617;
    color: #f1f5f9;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #020617;
    color: #f1f5f9;
}

/* --- Labels Gerais e de Formulário (Sem tarja escura) --- */
QLabel {
    background-color: transparent;
}

QLabel.form-label,
QLabel[formLabel="true"] {
    font-family: "Segoe UI";
    font-size: 11pt;
    font-weight: 500;
    color: #cbd5e1;
    margin-bottom: 4px;
    background-color: transparent;
}

QLabel.form-label:disabled,
QLabel[formLabel="true"]:disabled {
    color: #64748b;
}

/* --- MenuBar & Menu --- */
QMenuBar {
    background-color: #0f172a;
    border-bottom: 1px solid #334155;
    padding: 2px 4px;
    color: #f1f5f9;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    border-radius: 4px;
    color: #cbd5e1;
}

QMenuBar::item:selected {
    background-color: #1e293b;
    color: #f1f5f9;
}

QMenu {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    color: #f1f5f9;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    color: #f1f5f9;
}

QMenu::item:selected {
    background-color: #1e3a5f;
    color: #93c5fd;
}

QMenu::item:disabled {
    color: #64748b;
}

QMenu::separator {
    height: 1px;
    background: #334155;
    margin: 4px 8px;
}

/* --- ToolBar --- */
QToolBar {
    background-color: #0f172a;
    border-bottom: 1px solid #334155;
    padding: 4px 8px;
    spacing: 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #334155;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #cbd5e1;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 10px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #1e293b;
    color: #f1f5f9;
}

QToolButton:pressed {
    background-color: #334155;
}

QToolButton:checked {
    background-color: #1e3a5f;
    color: #60a5fa;
    border: 1px solid #3b82f6;
}

/* --- Buttons --- */
QPushButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #475569;
    border-radius: 4px;
    padding: 6px 16px;
    min-height: 22px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #64748b;
    color: #f1f5f9;
}

QPushButton:pressed {
    background-color: #0f172a;
}

QPushButton:focus {
    border: 2px solid #60a5fa;
}

QPushButton:disabled {
    background-color: #0f172a;
    color: #64748b;
    border-color: #1e293b;
}

QPushButton[variant="primary"],
QPushButton[primary="true"] {
    background-color: #60a5fa;
    color: #020617;
    border: 1px solid #60a5fa;
    font-weight: 600;
}

QPushButton[variant="primary"]:hover,
QPushButton[primary="true"]:hover {
    background-color: #93c5fd;
    border-color: #93c5fd;
}

QPushButton[variant="primary"]:pressed,
QPushButton[primary="true"]:pressed {
    background-color: #3b82f6;
    border-color: #3b82f6;
}

QPushButton[variant="secondary"],
QPushButton[secondary="true"] {
    background-color: #1e293b;
    border: 1px solid #475569;
    color: #e2e8f0;
}

QPushButton[variant="secondary"]:hover,
QPushButton[secondary="true"]:hover {
    background-color: #334155;
    border-color: #64748b;
    color: #f1f5f9;
}

QPushButton[variant="ghost"],
QPushButton[ghost="true"] {
    background-color: transparent;
    color: #cbd5e1;
    border: 1px solid transparent;
}

QPushButton[variant="ghost"]:hover,
QPushButton[ghost="true"]:hover {
    background-color: #1e293b;
    color: #f1f5f9;
}

QPushButton[variant="danger"],
QPushButton[danger="true"] {
    background-color: #f87171;
    color: #020617;
    border: 1px solid #f87171;
    font-weight: 600;
}

QPushButton[variant="danger"]:hover,
QPushButton[danger="true"]:hover {
    background-color: #fca5a5;
    border-color: #fca5a5;
}

/* --- Inputs --- */
QLineEdit, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #475569;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #1e3a5f;
    selection-color: #f1f5f9;
    min-height: 32px;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border-color: #64748b;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 2px solid #60a5fa;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: #0f172a;
    color: #64748b;
    border-color: #334155;
}

QLineEdit[error="true"] {
    border: 2px solid #f87171;
    background-color: #450a0a;
}

/* --- ComboBox --- */
QComboBox {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #475569;
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 32px;
}

QComboBox:hover {
    border-color: #64748b;
}

QComboBox:focus {
    border: 2px solid #60a5fa;
}

QComboBox QAbstractItemView {
    background-color: #0f172a;
    color: #f1f5f9;
    border: 1px solid #334155;
    selection-background-color: #1e3a5f;
    selection-color: #f1f5f9;
    outline: none;
}

/* --- CheckBox & RadioButton --- */
QCheckBox, QRadioButton {
    background-color: transparent;
    color: #f1f5f9;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #64748b;
    background-color: #1e293b;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #60a5fa;
    border-color: #60a5fa;
}

/* --- GroupBox / Cards (Container com cor sólida destacada) --- */
QGroupBox {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
    color: #cbd5e1;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #cbd5e1;
    background-color: transparent;
}

QGroupBox QLabel,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    background-color: transparent;
}

/* --- DockWidget --- */
QDockWidget {
    color: #cbd5e1;
    font-weight: 600;
}

QDockWidget::title {
    background-color: #1e293b;
    border-top: 1px solid #334155;
    border-bottom: 1px solid #334155;
    padding: 6px 10px;
    text-align: left;
}

/* --- TabWidget & TabBar --- */
QTabWidget::pane {
    border: 1px solid #334155;
    background-color: #0f172a;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover {
    background-color: #334155;
    color: #f1f5f9;
}

QTabBar::tab:selected {
    background-color: #0f172a;
    color: #60a5fa;
    border-bottom: 2px solid #60a5fa;
    font-weight: 600;
}

/* --- ListWidget, TreeView, TableView --- */
QListWidget, QTreeView, QTableView {
    background-color: #0f172a;
    alternate-background-color: #020617;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    gridline-color: #334155;
    outline: none;
}

QListWidget::item, QTreeView::item {
    padding: 6px 10px;
    border-radius: 4px;
}

QListWidget::item:hover, QTreeView::item:hover, QTableView::item:hover {
    background-color: #1e293b;
}

QListWidget::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #1e3a5f;
    color: #f1f5f9;
    border-left: 3px solid #60a5fa;
    font-weight: 600;
}

QHeaderView::section {
    background-color: #0f172a;
    color: #cbd5e1;
    font-weight: 600;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #334155;
    border-right: 1px solid #334155;
}

/* --- StatusBar --- */
QStatusBar {
    background-color: #0f172a;
    color: #94a3b8;
    border-top: 1px solid #334155;
    font-size: 9pt;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background-color: transparent;
}

/* --- ToolTip --- */
QToolTip {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
}

/* --- ScrollBar --- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #475569;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #64748b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #475569;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #64748b;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}