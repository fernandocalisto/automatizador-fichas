/* ==========================================================================
   Automatizador de Fichas v0.2.0 — Light Theme (Tailwind Slate + Blue)
   ========================================================================== */

QWidget {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #f8fafc;
    color: #0f172a;
}

/* --- Form Layout Padrão --- */
QFormLayout {
    label-alignment: AlignLeft | AlignVCenter;
    form-alignment: AlignLeft | AlignTop;
    field-growth-policy: ExpandingFieldsGrow;
    row-wrap-policy: DontWrapRows;
    horizontal-spacing: 12px;
    vertical-spacing: 8px;
}

/* --- Labels de Formulário --- */
QLabel.form-label,
QLabel[formLabel="true"],
QGroupBox QLabel {
    font-family: "Segoe UI";
    font-size: 11pt;
    font-weight: 500;
    color: #334155;
    margin-bottom: 4px;
    background-color: transparent;
}

QLabel.form-label:disabled,
QLabel[formLabel="true"]:disabled,
QGroupBox QLabel:disabled {
    color: #94a3b8;
}

/* --- MenuBar & Menu --- */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 2px 4px;
    color: #0f172a;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    border-radius: 4px;
    color: #334155;
}

QMenuBar::item:selected {
    background-color: #f1f5f9;
    color: #0f172a;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px;
    color: #0f172a;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    color: #0f172a;
}

QMenu::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}

QMenu::item:disabled {
    color: #cbd5e1;
}

QMenu::separator {
    height: 1px;
    background: #e2e8f0;
    margin: 4px 8px;
}

/* --- ToolBar --- */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 4px 8px;
    spacing: 8px;
}

QToolBar::separator {
    width: 1px;
    background-color: #e2e8f0;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    color: #334155;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

QToolButton:pressed {
    background-color: #e2e8f0;
}

QToolButton:checked {
    background-color: #eff6ff;
    color: #2563eb;
    border: 1px solid #bfdbfe;
}

/* --- Buttons --- */
QPushButton {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 8px 16px;
    min-height: 22px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
    color: #0f172a;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton:focus {
    border: 2px solid #3b82f6;
}

QPushButton:disabled {
    background-color: #f1f5f9;
    color: #cbd5e1;
    border-color: #e2e8f0;
}

QPushButton[variant="primary"],
QPushButton[primary="true"] {
    background: #3b82f6;
    background-color: #3b82f6;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

QPushButton[variant="primary"]:hover,
QPushButton[primary="true"]:hover {
    background: #2563eb;
    background-color: #2563eb;
    border-color: #2563eb;
}

QPushButton[variant="primary"]:pressed,
QPushButton[primary="true"]:pressed {
    background: #1d4ed8;
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QPushButton[variant="secondary"],
QPushButton[secondary="true"] {
    background: #ffffff;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
}

QPushButton[variant="secondary"]:hover,
QPushButton[secondary="true"]:hover {
    background: #f1f5f9;
    background-color: #f1f5f9;
    border-color: #94a3b8;
    color: #0f172a;
}

QPushButton[variant="ghost"],
QPushButton[ghost="true"] {
    background: transparent;
    background-color: transparent;
    color: #475569;
    border: 1px solid transparent;
}

QPushButton[variant="ghost"]:hover,
QPushButton[ghost="true"]:hover {
    background: #f1f5f9;
    background-color: #f1f5f9;
    color: #0f172a;
}

QPushButton[variant="danger"],
QPushButton[danger="true"] {
    background: #ef4444;
    background-color: #ef4444;
    color: #ffffff;
    border: 1px solid #ef4444;
}

QPushButton[variant="danger"]:hover,
QPushButton[danger="true"]:hover {
    background: #dc2626;
    background-color: #dc2626;
    border-color: #dc2626;
}

/* --- Inputs Padrão --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
    padding: 8px 12px;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    background: #ffffff;
    background-color: #ffffff;
    color: #0f172a;
    min-height: 32px;
    selection-background-color: #dbeafe;
    selection-color: #0f172a;
}

QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    padding: 8px 12px;
    selection-background-color: #dbeafe;
    selection-color: #0f172a;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover, QTimeEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border-color: #94a3b8;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 2px solid #3b82f6;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QDateEdit:disabled, QTimeEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QLineEdit[error="true"] {
    border: 2px solid #ef4444;
    background-color: #fef2f2;
}

/* --- ComboBox Popup --- */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    selection-background-color: #dbeafe;
    selection-color: #0f172a;
    outline: none;
}

/* --- CheckBox & RadioButton --- */
QCheckBox, QRadioButton {
    color: #0f172a;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #94a3b8;
    background-color: #ffffff;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
}

/* --- GroupBox / Collapsible Sections --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    padding-top: 16px;
    font-weight: 600;
    color: #334155;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: #475569;
}

/* --- DockWidget --- */
QDockWidget {
    color: #334155;
    font-weight: 600;
}

QDockWidget::title {
    background-color: #f1f5f9;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 6px 10px;
    text-align: left;
}

/* --- TabWidget & TabBar --- */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover {
    background-color: #f8fafc;
    color: #0f172a;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2563eb;
    border-bottom: 2px solid #3b82f6;
    font-weight: 600;
}

/* --- ListWidget, TreeView, TableView --- */
QListWidget, QTreeView, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    gridline-color: #e2e8f0;
    outline: none;
}

QListWidget::item, QTreeView::item {
    padding: 8px 12px;
    border-radius: 4px;
}

QListWidget::item:hover, QTreeView::item:hover, QTableView::item:hover {
    background-color: #eff6ff;
}

QListWidget::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #dbeafe;
    color: #1e3a5f;
    border-left: 3px solid #2563eb;
    font-weight: 600;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #334155;
    font-weight: 600;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
}

/* --- StatusBar --- */
QStatusBar {
    background-color: #ffffff;
    color: #475569;
    border-top: 1px solid #e2e8f0;
    font-size: 9pt;
    padding: 4px 8px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background-color: transparent;
    padding: 4px 12px;
}

/* --- ToolTip --- */
QToolTip {
    background-color: #0f172a;
    color: #ffffff;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
}

/* --- ScrollBar --- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
