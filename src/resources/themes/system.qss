/* ==========================================================================
   Automatizador de Fichas v0.2.0 — System Theme Fallback
   ThemeService resolves OS color scheme (QApplication.styleHints().colorScheme())
   and applies dark.qss or light.qss dynamically; this file provides the
   baseline neutral sheet when system.qss is loaded directly.
   ========================================================================== */

QWidget {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
}

QPushButton {
    border-radius: 4px;
    padding: 6px 16px;
    min-height: 22px;
    font-weight: 500;
}

QPushButton[variant="primary"] {
    background-color: #3b82f6;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

QPushButton[variant="primary"]:hover {
    background-color: #2563eb;
    border-color: #2563eb;
}

QPushButton[variant="danger"] {
    background-color: #ef4444;
    color: #ffffff;
    border: 1px solid #ef4444;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    border-radius: 4px;
    padding: 6px 10px;
}

QGroupBox {
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px;
    font-weight: 600;
}

QToolTip {
    border-radius: 6px;
    padding: 6px 10px;
}
